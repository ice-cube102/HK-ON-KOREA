{
  "entities": {
    "FeedbackProposal": {
      "title": "FeedbackProposal",
      "description": "Staff-submitted text modification proposal or site feedback",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorEmail": { "type": "string", "maxLength": 150 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "sectionKey": { "type": "string", "maxLength": 100 },
        "sectionTitle": { "type": "string", "maxLength": 200 },
        "targetType": { "type": "string", "enum": ["text", "image"] },
        "originalText": { "type": "string", "maxLength": 5000 },
        "proposedText": { "type": "string", "maxLength": 5000 },
        "originalImage": { "type": "string", "maxLength": 2000 },
        "proposedImage": { "type": "string", "maxLength": 2000 },
        "reason": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "applied", "rejected"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["authorName", "authorUid", "sectionKey", "proposedText", "status"]
    },
    "SiteOverride": {
      "title": "SiteOverride",
      "description": "Live applied text or image override approved by admin",
      "type": "object",
      "properties": {
        "sectionKey": { "type": "string", "maxLength": 100 },
        "sectionTitle": { "type": "string", "maxLength": 200 },
        "targetType": { "type": "string", "enum": ["text", "image"] },
        "text": { "type": "string", "maxLength": 5000 },
        "appliedBy": { "type": "string", "maxLength": 150 },
        "updatedAt": { "type": "string" }
      },
      "required": ["sectionKey", "text"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Administrator account record configured by super developer admin",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["developer", "admin"] },
        "permissions": { "type": "object" },
        "addedBy": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "SiteVersion": {
      "title": "SiteVersion",
      "description": "Snapshot of previous and current content for rollbacks and version history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sectionKey": { "type": "string" },
        "sectionTitle": { "type": "string" },
        "targetType": { "type": "string", "enum": ["text", "image"] },
        "previousValue": { "type": "string" },
        "newValue": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorName": { "type": "string" },
        "changeNote": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["sectionKey", "newValue"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail log of admin actions such as apply, revert, delete, reject, and permission changes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actionType": { "type": "string" },
        "target": { "type": "string" },
        "targetTitle": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["actionType", "target"]
    }
  },
  "firestore": {
    "/feedback_proposals/{proposalId}": {
      "schema": { "$ref": "FeedbackProposal" },
      "description": "Collection of employee text change requests and feedbacks"
    },
    "/site_overrides/{overrideId}": {
      "schema": { "$ref": "SiteOverride" },
      "description": "Publicly readable text overrides that have been approved by admin"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "AdminUser" },
      "description": "List of authorized administrator emails and their roles"
    },
    "/site_versions/{versionId}": {
      "schema": { "$ref": "SiteVersion" },
      "description": "Historical snapshots of content overrides for multi-version rollbacks"
    },
    "/activity_logs/{logId}": {
      "schema": { "$ref": "ActivityLog" },
      "description": "Audit trail log records for administrator and developer actions"
    }
  }
}
